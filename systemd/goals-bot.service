[Unit]
Description=Goals Telegram Bot (Shaolen)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/shaolen
Environment=PATH=/root/shaolen/venv/bin:/usr/bin:/usr/local/bin
EnvironmentFile=/root/shaolen/.env
ExecStart=/root/shaolen/venv/bin/python /root/shaolen/bot.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
